{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gophermind.local/schema/task-node/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "id",
    "kind",
    "title",
    "description",
    "brief_ref",
    "status"
  ],
  "properties": {
    "spec_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "root",
        "component",
        "function"
      ]
    },
    "parent": {
      "type": "string"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "brief_ref": {
      "type": "string",
      "description": "Heading anchor in the brief this node came from"
    },
    "wave": {
      "type": "integer",
      "minimum": 0,
      "description": "0 = contracts; assigned from depends_on"
    },
    "model_tier": {
      "enum": [
        "strong",
        "standard",
        "any"
      ],
      "description": "Contracts and shared interfaces use strong"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Definition revision round, 0 = original"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependency_signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "file",
        "signature",
        "inputs",
        "outputs"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "returns"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "returns": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "sentinel",
                  "wrapped",
                  "typed",
                  "panic",
                  "http_status",
                  "exit_code",
                  "other"
                ]
              },
              "test": {
                "type": "string"
              }
            }
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "level",
          "given",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "enum": [
              "unit",
              "integration",
              "acceptance"
            ]
          },
          "given": {
            "type": "string"
          },
          "expect": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "polarity": {
            "enum": [
              "success",
              "negative",
              "boundary",
              "property"
            ]
          },
          "covers": {
            "type": "string",
            "pattern": "^(happy|error:[0-9]+|input:[A-Za-z_][A-Za-z0-9_]*)$"
          }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host",
          "critical"
        ],
        "properties": {
          "host": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secret names only"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_revisions": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "claimed",
        "in_progress",
        "verified",
        "failed",
        "needs_revision",
        "escalated"
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "worker": {
          "type": "string"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model",
          "provider",
          "revision",
          "verdict"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "order": {
            "type": "integer",
            "description": "Position in the fallback chain, 1 = first try"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "error"
            ]
          },
          "tests_passed": {
            "type": "integer"
          },
          "tests_total": {
            "type": "integer"
          },
          "failed_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_reason": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "node_class": {
      "enum": [
        "pure",
        "validation",
        "handler",
        "client",
        "storage",
        "concurrency",
        "wiring",
        "other"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CAF][0-9]+$"
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach_chosen",
        "steps"
      ],
      "properties": {
        "approach_chosen": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alternatives": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approach",
              "rejected_because"
            ],
            "properties": {
              "approach": {
                "type": "string",
                "minLength": 1
              },
              "rejected_because": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "portability": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch",
            "go_min",
            "cgo"
          ],
          "properties": {
            "os": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "arch": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "go_min": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            },
            "cgo": {
              "type": "boolean"
            },
            "build_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "security": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trust_boundary"
          ],
          "properties": {
            "trust_boundary": {
              "enum": [
                "none",
                "internal",
                "external_input",
                "external_output",
                "both"
              ]
            },
            "untrusted_inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "authz": {
              "type": "string"
            },
            "secret_use": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "threats": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threat",
                  "mitigation"
                ],
                "properties": {
                  "threat": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mitigation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "performance": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complexity",
            "concurrency",
            "hot_path"
          ],
          "properties": {
            "complexity": {
              "type": "string",
              "minLength": 1
            },
            "max_latency_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "alloc_budget": {
              "type": "string"
            },
            "concurrency": {
              "enum": [
                "none",
                "safe_for_concurrent_use",
                "single_goroutine"
              ]
            },
            "hot_path": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "observability": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "log_events"
          ],
          "properties": {
            "log_events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "msg"
                ],
                "properties": {
                  "level": {
                    "enum": [
                      "debug",
                      "info",
                      "warn",
                      "error"
                    ]
                  },
                  "msg": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "counter",
                      "gauge",
                      "histogram"
                    ]
                  }
                }
              }
            },
            "trace_span": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "refactor_notes": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what",
              "why",
              "when"
            ],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "profile_hooks": {
      "oneOf": [
        {
          "$ref": "#/$defs/na"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bench",
              "pprof",
              "trace"
            ]
          }
        }
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9:-]*$"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "kind",
          "answer",
          "answered_by",
          "raised_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "decision",
              "fact"
            ]
          },
          "fact_key": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended": {
            "type": "string"
          },
          "recommended_why": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "answered_by": {
            "enum": [
              "human",
              "accepted",
              "unattended-default",
              "probe"
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "raised_by": {
            "type": "string",
            "minLength": 1
          },
          "settled_at": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "answer"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "function"
          }
        }
      },
      "then": {
        "required": [
          "parent",
          "contract",
          "tests",
          "wave"
        ],
        "properties": {
          "tests": {
            "minItems": 1,
            "contains": {
              "required": [
                "command"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "root"
          }
        }
      },
      "else": {
        "required": [
          "parent"
        ]
      }
    }
  ],
  "$defs": {
    "param": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "go_type": {
          "type": "string"
        }
      }
    },
    "na": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_applicable"
      ],
      "properties": {
        "not_applicable": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}